# Per-page HTML files — generated by build.js from index.html so each
# URL serves its own <title>, description, canonical and OG tags. This
# is a rewrite (200), not a redirect (301), so the URL bar keeps the
# pretty path while Netlify serves the specific file.
/events           /events.html            200
/resources        /resources.html         200
/fc-offers        /fc-offers.html         200
/funding-support  /funding-support.html   200

# Dynamic offer sharing — Netlify function handles OG tags
/offer/*        /.netlify/functions/offer-share    200

# Branded OG image
/og-offers-default.png  /.netlify/functions/og-offers-default   200
